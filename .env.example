# Copy to .env.local. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Neon). Use the connection string from your Neon dashboard.
DATABASE_URL=
# Optional: Neon's direct (non-pooled) string, used only for migrations.
# DATABASE_URL_UNPOOLED=

# Admin login. Make the secret with: openssl rand -base64 32
# Use a different secret for the live site.
BETTER_AUTH_SECRET=
# The exact address you open in the browser. The live domain when deployed.
BETTER_AUTH_URL=http://localhost:3000

# Needed later for payments.
# PAYSTACK_SECRET_KEY=
